<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= forced ? 'Choose a staff password' : 'Change password' %> · Shopfront</title>
  <link rel="stylesheet" href="/static/css/admin.css" />
</head>
<body class="login-body">
  <form class="login-card" method="post" action="/admin/password">
    <input type="hidden" name="_csrf" value="<%= csrf %>" />
    <p class="eyebrow">Before the QR goes on a table</p>
    <h1><%= forced ? 'Choose a staff password' : 'Change password' %></h1>
    <% if (forced) { %>
      <p>This is still the default password (changeme). Set a new one before you print the table card. Guests can keep reading the menu.</p>
    <% } else { %>
      <p>Use at least 6 characters. Do not use changeme.</p>
    <% } %>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <label>New password
      <input type="password" name="password" minlength="6" required autofocus autocomplete="new-password" />
    </label>
    <button type="submit"><%= forced ? 'Save and open the editor' : 'Update password' %></button>
    <a href="/">← View menu</a>
    <% if (!forced) { %><a href="/admin">Back to editor</a><% } %>
  </form>
</body>
</html>
