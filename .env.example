PORT=3000
# SQLite file and uploaded dish photos.
# Docker Compose sets this to /data (named volume shopfront_data).
# On a Node host, put this OUTSIDE the directory a deploy overwrites.
# Hostinger Node Web Apps replace the app directory, so ./data does not survive a redeploy.
DATA_DIR=./data
# Initial staff password, applied when the database is created or re-seeded.
# changeme cannot open the editor: the first login must change it.
ADMIN_PASSWORD=changeme
# Origin encoded in the table-card QR. Defaults to the request host.
# PUBLIC_BASE_URL=https://menu.example.com
# COOKIE_SECURE=1
